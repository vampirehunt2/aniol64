                        ;
                        ; Page 1
                        ;

                        ;
                        ;
                        ;  SYSTEM INTERFACE
                        ;
                        ;	file	'8k Basic'

0000                    BASIC:				;FULL RESTART INITIALIZATION
0000                    SYSINITJ:
0000  C3 9B20           	JMP	INITIALZ
0003                    REENTERBASIC:			;REENTER AFTER PAUSE
0003  C3 6106           	JMP	cmndrstr

                        ;
                        ;  Monitor Routines
                        ;
                        ;co	equ	406h	;c -> screen
                        ;cinb	equ	409h	;keyboard -> ac, carry set if any
                        ;dclr	equ	538h	;clear screen
                        ;xco	equ	4f4h	;c -> printer (blocking)

                        ;
                        ; I don't know which monitor was used here. So instead the i/o functions
                        ; are added for the Altair 88-SIO2.
                        ;
                        ; July 2014, Udo Munk
                        ;

0006  DB 10             co:	in	10h		;read console status
0008  E6 02             	ani	2		;if not ready
000A  CA 0600           	jz	co		;keep waiting
000D  79                	mov	a,c		;get character
000E  D3 11             	out	11h		;and print it
0010  C9                	ret

0011  DB 10             cinb:	in	10h		;read console status
0013  E6 01             	ani	1		;check if character available
0015  C8                	rz			;return if not with carry clear
0016  DB 11             	in	11h		;get character
0018  37                	stc			;and set carry flag
0019  C9                	ret

001A                    dclr:				;not implemented yet
001A  C9                	ret

001B                    xco:				;not implemented yet
001B  C9                	ret

                        ;
                        ;  NON-BLOCKING INPUT
                        ;   CHAR IN AC IF NOT ZERO
                        ;   ZERO SET IF NONE
                        ;
001C                    SYSKEYIN:
001C  C5                	push	b
001D  D5                	push	d
001E  E5                	push	h
001F  CD 1100           	call	cinb	;get char
0022  D2 3300           	jnc	syskeynone
0025  FE 00             	cpi	0
0027  CA 3700           	jz	clearscreen
002A  FE 1F             	cpi	1fh	;us to bring to 14
002C  CA 3D00           	jz	gomonitor
002F                    syskeyinret:
002F  E1                	pop	h
0030  D1                	pop	d
0031  C1                	pop	b
0032  C9                	ret
0033                    syskeynone:
0033  97                	sub	a	;set zero
0034  C3 2F00           	jmp	syskeyinret
0037                    clearscreen:
0037  CD 1A00           	call	dclr	;clear screen
003A  C3 3300           	jmp	syskeynone
003D                    gomonitor:
003D  CF                	rst	1	;about using us (^_)
003E  00                	nop	
003F  00                	nop
                        ;
                        ;  SEND AC TO SCREEN
                        ;
0040                    SYSDISPL:
0040  F5                	push	psw
0041  C5                	push	b
0042  D5                	push	d

                        ;
                        ; Page 2
                        ;

0043  E5                	push	h
0044  4F                	mov	c,a
0045  CD 0600           	call	co	;c to screen
0048  3A 7903           	lda	p3010	;print on the 3010 if zero
004B  A7                	ana	a	
004C  CC 1B00           	cz	xco	;yes print
004F  E1                	pop	h
0050  D1                	pop	d
0051  C1                	pop	b
0052  F1                	pop	psw
0053  C9                	RET
                        ;
                        ;  CHECK FOR BREAK REQUEST
                        ;   SET ZERO TO BREAK
                        ;
0054                    SYSBREAK:
0054  CD 1C00           	call	syskeyin
0057  CA 5C00           	jz	nobreak
005A  97                	sub	a
005B  C9                	ret
005C                    nobreak:
005C  3E 01             	mvi	a,1
005E  B7                	ora	a
005F  C9                	ret
                        ;
                        ;  DELAY
                        ;
0060                    SYSWAIT:
0060  C9                	RET
                        ;
                        ;  RETURN TO MONITOR
                        ;
      = B400            MONITOR	EQU	0B400H
0061                    SYSQUIT:
0061  C3 00B4           	JMP	MONITOR

