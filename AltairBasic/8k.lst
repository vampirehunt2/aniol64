04FC  EB                	XCHG			;ON STACK ABOVE HL
04FD  21 DAFF           	LXI	H,-38
0500  39                	DAD	SP
0501  CD D704           	CALL	CMHLLTDE
0504  EB                	XCHG
0505  D1                	POP	D
0506  D0                	RNC
