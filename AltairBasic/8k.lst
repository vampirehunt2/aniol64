                        ;
                        ;  CSAVE/CLOAD ROCESSORS
                        ;    save filename - save on diskette
                        ;    load filename - get from diskette
                        ;
                        ;  load and save programs from the disk
                        ;
      = B400            d14base	equ	0b400h
      = B000            fsprom	equ	0b000h
      = B39B            bootstart  equ	fsprom+39bh	;load image files
      = B8E0            directorylookup  equ  d14base+4e0h  ;find filename
      = B796            opens	equ	d14base+396h	;open stream
      = B7DC            puts	equ	d14base+3dch	;put char
      = B82D            closes	equ	d14base+42dh	;close stream
                        ;
1876                    cldstm:
1876  CD CD18           	call	setfilename	;parse filename
1879  CD E0B8           	call	directorylookup
187C  D2 8B18           	jnc	namenotfound
187F  CD 9BB3           	call	bootstart
1882  CD EE18           	call	checkprogram
1885  CD 1505           	call	newload		;reset program pointers
1888  C3 2F06           	jmp	cmndstrt
188B                    namenotfound:
188B  1E E1             	mvi	e,errnfi-errn	;file not saved
188D  C3 0706           	jmp	errmsg


1890                    csvstm:
1890  CD CD18           	call	setfilename
1893  06 02             	mvi	b,2		;write enable
1895  CD 96B7           	call	opens		;open stream (only one in D14)
1898  D2 C818           	jnc	cannotopen	; -disk full or other bad stuff
189B  CD EE18           	call	checkprogram
189E  E5                	push	h		;save end pointer
189F  2A 9703           	lhld	progbase	;first address
18A2  4D                	mov	c,l
18A3  CD DCB7           	call	puts
18A6  4C                	mov	c,h
18A7  CD DCB7           	call	puts
18AA  0E 00             	mvi	c,0		;start address = 0 for no start
18AC  CD DCB7           	call	puts
18AF  CD DCB7           	call	puts
18B2  D1                	pop	d		;de has end address=1
18B3                    saveloop:
18B3  4E                	mov	c,m		;get char
18B4  23                	inx	h
18B5  CD DCB7           	call	puts		;and send t file
18B8  7C                	mov	a,h		;is this the end?
18B9  BA                	cmp	d
18BA  C2 B318           	jnz	saveloop
18BD  7D                	mov	a,l
18BE  BB                	cmp	e
18BF  C2 B318           	jnz	saveloop
18C2  CD 2DB8           	call	closes		;yes

