0372  20536176 656400

                        ;
                        ;  Page 15
                        ;

                        ;
                        ;  INTERPRETER VARIABLES
                        ;
                        ;            VARIABLES MARKED WITH SAME CHARACTER IN COLUMN 71
                        ;               ARE FIXED IN THAT ORDER.
                        ;


0379  01                p3010:	    db	1		;0 to print on 3010	
037A  00                REAINPFL:   DB	0		;READ/INPUT FLAG	
037B  00                PRINTFLG:   DB	0		;PRINT/NO PRINT FLAG	
037C  01                TRACEFLG:   DB	1		;TRACE/NO TRACE FLAG
037D  00                SCANPFLG:   DB	0		;SCAN/NOSCAN PARENTHESIS FLAG
037E  01                SCANPFLE:   DB	1		;ARRAY NAME FOR ERASE
      = 00AB            SCANPFLD    EQU	KEYS-'('	;NO ARRAY ELEMENTS WANTED
037F  00                MATSCCNT:   DB	0		;SUBSCRIPT COUNT
0380  00                MATDMFLG:   DB	0		;SCANNING FOR VAR/DIMENSION V
0381  00                TYPEFLG:    DB	0		;TYPE FLAG                  V
      = 0002            TYPEINTG    EQU	2		;TYPE OF INTEGER
      = 0003            TYPESTRG    EQU	3		;TYPE OF STRING
      = 0004            TYPESING    EQU	4		;TYPE OF SINGLE FLOATING POINT
      = 0008            TYPEDUBL    EQU	8		;TYPE OF DOUBLE FLOATING POINT
      = 0020            TYPEDEF     EQU	080H/4		;MARKING BIT FOR USER-FUNCTION


0382  00                STRGTMPL:   DB	0		;TEMP STRING DESCRIPTR, LEN  S
0383  0000              STRGTMPA:   DW	0		;TEMP STRING DESCRIPTR, ADDR S
0385  0000              SCANPTR1:   DW	0		;SCAN POINTER
0387  0000              SCANPTR2:   DW	0		;SCAN POINTER
0389  FFFF              CURLINE:    DW	-1		;CURRENT LINE NUMBER
038B  0000              CURLINES:   DW	0		;SAVED CURRENT LINE NUMBER
038D  A620              PROGCNTR:   DW	ENDINTRP+12	;CURRENT PROGRAM LOCATION
      = 038D            VARINDEX    EQU	PROGCNTR	;INDEX VARIABLE OF FOR
038F  0000              PROGCNTS:   DW	0		;SAVED CURRENT PROGRAMLOCATION
0391  0000              CURLDATA:   DW	0		;CURRENT DATA LINE NUMBER
0393  9A20              CURDATAP:   DW	ENDINTRP	;CURRENT DATA POINTER
0395  2D21              INPTBUFR:   DW	INITSTSP	;INPUT BUFFER ADDRESS
      = 0064            PREDREL	    EQU	064H		;PRECEDENCE OF RELATION
      = 0070            PREDNUM	    EQU	070H		;LOWER BNDRY OF NUM OP PREC.
      = 005A            PREDNOT	    EQU	05AH		;PRECEDENCE OF NOT OPERATOR
      = 007D            PREDUMIN    EQU	07DH		;PRECEDENCE OF UNARY MINUS
      = 009D            LINESYZE    EQU	79+78		;DEFAULT LINESYZE
      = 000E            ITEMSIZE    EQU	14		;DEFAULT WIDTH OF PRINT ITEM

                        ;
                        ;  Page 16
                        ;

                        ;
                        ;  MEMORY ALLOCATIN POINTERS
                        ;


                        ;
      = 8000            LIMLOWER   EQU	08000H
      = AF00            LIMUPPER   EQU	0AF00H
                        ;
                        ;  MEMORY LAYOUT
                        ;
                        ;  ENCODE BUFFER
                        ;  PROGRAM
                        ;  VARIABLES
                        ;  ARRAYS
                        ;  FREE SPACE  /  STACK (INCLUDING BUFFERS)
                        ;  FREE STRING SPACE
                        ;  STRINGS
                        ;  STRING TEMPORARIES
                        ;  FREE STRING TEMPORARIES
                        ;
0397  A720              PROGBASE:    DW	ENDINTRP+13	;BASE OF PROGRAM SPACE
0399  A920              VARTABLE:    DW	ENDINTRP+15	;BASE OF VARIABLE TABLE
039B  A920              MATTABLE:    DW	ENDINTRP+15	;BASE OF ARRAY TABLE
039D  A920              FREELIMT:    DW ENDINTRP+15	;LOWER LIMIT OF FREE SPACE
039F  0622              STCKBASE:    DW	INITSTCK	;BASE OF STACK
03A1  1022              STRGFREE:    DW	INITSTCK+10	;FIRST FREE STRING SPACE	
03A3  1022              STRGBASE:    DW	INITSTCK+10	;BASE OF STRING SPACE
03A5  1122              STRGTMPP:    DW	INITSTCK+11	;STRING TEMPORARY ALLOC PTR
03A7  1622              STRGTLIM:    DW	INITSTCK+10+2*3	;STRING TEMPORARY LIMIT


03A9  0000              ACCUMLTR:    DB	0,0		;ACCUMULATOR			A
03AB  00                FLACCMSB:    DB	0		;SIGN-BIT/HIGH-ORDER MANTISSA	A
03AC  00                FLACCEXP:    DB	0		;EXPONENT			A
03AD  00                FLACCSSV:    DB	0		;SAVED SIGN			A

03AE  01                NULLCNT:     DB 1		;# OF NULLS TO INSERT AFTER (CR)
03AF  01                CURSPOS:     DB	1		;CHARACTER CURSOR POSITION	C
03B0  63                CURSLIM:     DB 256-LINESYZE	;OUTPUT CURSOR LIMIT		C

03B1  00                FLSCR0:      DB	0		;FLOATING POINT SCRATCH AREA
03B2  01                FLSCR1:      DB 1
03B3  02                FLSCR2:      DB	2
03B4  03                FLSCR3:      DB	3

      = 03B1            INOTINS      EQU FLSCR0		;INPUT/OUTPUT INSTRUCTIONS
      = 00DB            OPCINP       EQU 0DBH		;INPUT INSTRUCTION
      = 00D3            OPCOUT       EQU 0D3H		;OUTPUT INSTRUCTION
      = 00C9            OPCRET       EQU 0C9H		;RETURN INSTRUCTION

03B5  52C74F80          RNDFCTSD:    DB  052h, 0c7h, 04fh, 080h   ;RANDOM SEED

                        ;
                        ; Page 17
                        ;

                        ;
                        ;
                        ;  GENERAL USE SUBROUTINES
                        ;
                        ;
                        ;  SCAN ONE CHARACTER AND CLASSIFY
                        ;
03B9                    SCANNXTV:
03B9  7E                	MOV	A,M		;SCAN CURRENT BYTE,
03BA  E3                	XTHL
03BB  BE                	CMP	M		;VERIFY MATCH,
03BC  23                	INX	H
03BD  E3                	XTHL
03BE  C2 0506           	JNZ	ERRASN		;SQUAWK ABOUT SYNTAX ERROR
03C1                    SCANNXT:
03C1  23                	INX	H		;SCAN FOR NEXT NON-BLANK CHAR
03C2  7E                	MOV	A,M		;C=NUMERIC CHARACTER
03C3  FE 3A             	CPI	':'		;Z=END OF STATEMENT
03C5  D0                	RNC
03C6  FE 20             	CPI	' '
03C8  CA C103           	JZ	SCANNXT
03CB  FE 30             	CPI	'0'
03CD  3F                	CMC
03CE  3C                	INR	A
03CF  3D                	DCR	A
03D0  C9                	RET

                        ;
                        ;  Page 18
                        ;

                        ;
                        ;  TEST FOR ALPHABETIC CHARACTER
                        ;
03D1                    ALPHACHK:
03D1  7E                	MOV	A,M		;TEST FOR ALPHABETIC CHARACTER
03D2                    ALPHACHA:
03D2  FE 7B             	CPI	'z'+1		;LOWER CASE
03D4  D0                	RNC
03D5  FE 61             	CPI	'a'		;LOWER CASE
03D7  D2 E103           	JNC	ALPHACHL
03DA  FE 5B             	CPI	'Z'+1		;C=ALPHABETIC
03DC  D0                	RNC
03DD  FE 41             	CPI	'A'		;UPPER CASE
03DF  3F                	CMC
03E0  C9                	RET
03E1                    ALPHACHL:
03E1  C6 E0             	ADI	'A'-'a'		;CONVERT LOWER TO UPPER
03E3  C9                	RET

                        ;
                        ;  MATCH CHARACTER OF BUFFER AGAINST CHARACTER IN A
                        ;
03E4                    CHARMTCH:
03E4  AE                	XRA	M		;MAKE MATCH TEST
03E5  C8                	RZ			;Z-SUCCESS]
03E6  FE 20             	CPI	'a'-'A'		;LOWER CASE - UPPER CASE
03E8  C0                	RNZ			;NOT LOWER-UPPER DIFFERENCE
03E9  CD D103           	CALL	ALPHACHK	;ALPHABETIC?
03EC  9F                	SBB	A
03ED  3C                	INR	A		;Z=C,S=0
03EE  C9                	RET

                        ;
                        ;  CHECK TYPE OF EXPRESSION	       LEN     CHAR
                        ;            RETURNS:  S => INTEGER	2	%
                        ;		       Z => STRING	3	$
                        ;		      PO => SINGLE	4	@
                        ;		      NC => DOUBLE	8	#
03EF                    TYPECHK:
03EF  3A 8103           	LDA	TYPEFLG
03F2                    TYPECHKA:
03F2  FE 05             	CPI	TYPESING+1
03F4  3D                	DCR	A
03F5  3D                	DCR	A
03F6  3D                	DCR	A
03F7  B7                	ORA	A
03F8  37                	STC
03F9  C9                	RET

                        ;
                        ;  Page 19
                        ;

                        ;
                        ;  SCAN A PAIR OF LINE NUMBER PARAMETERS
                        ;
03FA                    SCANLPRZ:
03FA  01 0000           	LXI	B,0		;DEFAULT SECOND IS FIRST
03FD                    SCANLPRM:
03FD  C4 2104           	CNZ	SCANLINN	;DEFAULT FIRST IS IN DE
0400  F5                	PUSH	PSW
0401  78                	MOV	A,B
0402  B1                	ORA	C		;ZERO DEFAULT IS FIRST PARAMETER
0403  C2 0804           	JNZ	SCANLPR1
0406  42                	MOV	B,D
0407  4B                	MOV	C,E
0408                    SCANLPR1:
0408  F1                	POP	PSW
0409  EB                	XCHG
040A  E3                	XTHL			;PUT FIRST ONTO STACK
040B  E5                	PUSH	H
040C  EB                	XCHG
040D  50                	MOV	D,B
040E  59                	MOV	E,C
040F  C8                	RZ
0410  FE AD             	CPI	KEYDIV		;SEPARATOR MUST BE '/'.
0412  CA 1A04           	JZ	SCANLPR2
0415  CD B903           	CALL	SCANNXTV	;bscan (val)
0418  2C                	DB	','		;   OR ','
0419  2B                	DCX	H
041A                    SCANLPR2:
041A  11 FFFF           	LXI	D,0FFFFH	;EMPTY SECOND OPERAND = END
041D  CD C103           	CALL	SCANNXT		;bscan ,
0420  C8                	RZ

                        ;
                        ;  SCAN A LINE NUMBER
                        ;
0421                    SCANLINN:
0421  2B                	DCX	H		;SCAN LINE # IN COMMAND/STATEMENT
0422                    SCANLINR:
0422  11 0000           	LXI	D,0		;DEFAULT LINE IS 0, INITIALIZE
0425                    SCANLINL:
0425  CD C103           	CALL	SCANNXT		;bscan ,
0428  D0                	RNC
0429  E5                	PUSH	H
042A  F5                	PUSH	PSW
042B  21 9819           	LXI	H,0FFFFH/10-1
042E  CD D704           	CALL	CMHLLTDE
0431  DA 0506           	JC	ERRASN
0434  62                	MOV	H,D
0435  6B                	MOV	L,E		;HL=10*DE
0436  19                	DAD	D
0437  29                	DAD	H
0438  19                	DAD	D
0439  29                	DAD	H
043A  F1                	POP	PSW
043B  D6 30             	SUI	'0'		;GET VALUE OF NEXT DIGIT

                        ;
                        ;  Page 20
                        ;

043D  5F                	MOV	E,A
043E  16 00             	MVI	D,000H
0440  19                	DAD	D		;AND ADD IT ON
0441  EB                	XCHG
0442  E1                	POP	H
0443  C3 2504           	JMP	SCANLINL

                        ;
                        ;  Page 21
                        ;

                        ;
                        ;  SEARCH FOR A GIVEN LINE NUMBER
                        ;
0446                    LINESRCH:
0446  2A 9703           	LHLD	PROGBASE	;LOOK FOR LINE NUMBER IN DE
0449                    LINESRCL:
0449  E5                	PUSH	H		;C=LINE FOUND
044A  CD 6304           	CALL	LINELINK	;BC=LINE LOCATION, IF FOUND
044D  CA 8608           	JZ	POPHLRET	;=NEXT LINE, IF NOT FOUND
0450  C5                	PUSH	B		;ADDRESS OF NEXT LINE
0451  7E                	MOV	A,M		;GET NUMBER OF CURRENT LINE
0452  23                	INX	H
0453  66                	MOV	H,M		;(from HL,MA)
0454  6F                	MOV	L,A
0455  CD D704           	CALL	CMHLLTDE
0458  E1                	POP	H		;HL=NEXT LINE
0459  C1                	POP	B
045A  3F                	CMC
045B  C8                	RZ
045C  D2 4904           	JNC	LINESRCL
045F  60                	MOV	H,B
0460  69                	MOV	L,C
0461  3F                	CMC
0462  C9                	RET

                        ;
                        ;  LINK TO NEXT LINE
                        ;
0463                    LINELINK:
0463  E5                	PUSH	H		;FIND ADDRESS OF NEXT LINE
0464  4E                	MOV	C,M		;Z=END OF PROGRAM
0465  23                	INX	H
0466  46                	MOV	B,M
0467  23                	INX	H
0468  E3                	XTHL
0469  09                	DAD	B		;ADD LENGTH TO ADDRESS
046A  E3                	XTHL
046B  78                	MOV	A,B
046C  B1                	ORA	C
046D  C1                	POP	B
046E  C9                	RET

                        ;
                        ;  Page 22
                        ;

                        ;
                        ;  INSERT/REPLACE LINE OF PROGRAM
                        ;
046F                    LINEINS:
046F  D5                	PUSH	D		;DE=LINE NUMBER
0470  D4 A706           	CNC	KEYSCAN		;C=ALREADY KEY-SCANNED
0473  CD C103           	CALL	SCANNXT		;bscan , NC=MUST BE KEY-SCANNED
0476  D1                	POP	D
0477  E5                	PUSH	H		;HL=TEXT TO INSERT
0478  D5                	PUSH	D
0479  C5                	PUSH	B		;BC=LENGTH OF TEXT
047A  F5                	PUSH	PSW		;Z=DELETE, NO REPLACE
047B  CD 4604           	CALL	LINESRCH	;LOOK FOR LINE
047E  C5                	PUSH	B		;SAVE LOCATION
047F  DC A904           	CC	LINEDEL		;DELETE IF PRESENT
0482  D1                	POP	D
0483  F1                	POP	PSW
0484  CA 8408           	JZ	POPHL3RT	;EXIT IF NOTHING MORE
0487  2A 9D03           	LHLD	FREELIMT	;PULL APART FOR NEW LINE
048A  E3                	XTHL
048B  C1                	POP	B
048C  E5                	PUSH	H
048D  09                	DAD	B
048E  CD DD04           	CALL	COPYCHK
0491  EB                	XCHG
0492  C1                	POP	B
0493  71                	MOV	M,C		;BEGINNING OF NEW LINE
0494  23                	INX	H
0495  70                	MOV	M,B
0496  23                	INX	H
0497  D1                	POP	D
0498  73                	MOV	M,E		;INSERT LINE NUMBER
0499  23                	INX	H
049A  72                	MOV	M,D
049B  23                	INX	H
049C  EB                	XCHG
049D  E1                	POP	H		;RECOVER TEXT POINTER
049E                    LINEINSL:
049E  7E                	MOV	A,M		;INSERT TEXT OF NEW LINE
049F  12                	STAX	D
04A0  23                	INX	H
04A1  13                	INX	D
04A2  B7                	ORA	A
04A3  C2 9E04           	JNZ	LINEINSL
04A6  C3 BF04           	JMP	LINEDELU


                        ;
                        ;  Page 23
                        ;

                        ;
                        ;  DELETE TEXT FROM PROGRAM
                        ;
04A9                    LINEDEL:
04A9  EB                	XCHG			;BC=BEGINNING OF TEXT TO REMOVE
04AA  79                	MOV	A,C
04AB  93                	SUB	E		;COMPUTE NETATIVE OF
04AC  6F                	MOV	L,A		;NUMBER OF BYTES DELETED
04AD  78                	MOV	A,B
04AE  9A                	SBB	D
04AF  67                	MOV	H,A
04B0  E5                	PUSH	H
04B1  2A 9D03           	LHLD	FREELIMT	;HL=BEGINNING OF TEXT SURVIVING
04B4                    LINEDELL:
