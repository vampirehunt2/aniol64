04C6  2A 9B03           	LHLD	MATTABLE
04C9  09                	DAD	B
04CA  22 9B03           	SHLD	MATTABLE
04CD  2A 9903           	LHLD	VARTABLE
04D0  09                	DAD	B
04D1  22 9903           	SHLD	VARTABLE
04D4  C3 5105           	JMP	CLEARPCN

                        ;
                        ;  MAKE SIXTEEN BIT COMPARISON
                        ;
04D7                    CMHLLTDE:
04D7  7C                	MOV	A,H		;COMPARE DE VS HL
04D8  92                	SUB	D		;C=HL<DE
04D9  C0                	RNZ
04DA  7D                	MOV	A,L
04DB  93                	SUB	E
04DC  C9                	RET

