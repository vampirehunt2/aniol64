{
    "configurations": [
    {
        "type": "dezog",
        "request": "launch",
        "name": "Simulator - Bare Z80",
        "remoteType": "zsim",
        "zsim": {
            "visualMemory": true,
            "memoryModel": "RAM",
            "customCode": {
		        "debug": true,
		        "jsPath": "dev/io.js"
	        }
        },
        "sjasmplus": [
            {
                "path": "C:/8bit/GitHub/aniol64/A64ROM/aniol64.sld"
            }
        ],
        "commandsAfterLaunch": ["-mv c000h 1000"],
        "history": {
            "reverseDebugInstructionCount": 1000000,
            "spotCount": 10,
            "codeCoverageEnabled": false
        },
        "startAutomatically": false,
        "rootFolder": "${workspaceFolder}",
        "loadObjs": [
            { "path": "C:/8bit/GitHub/aniol64/A64ROM/aniol64.bin", "start": "0x0000" },
            { "path": "C:/8bit/GitHub/aniol64/A64ROM/line.buf", "start": "0x8100" },
            { "path": "apl/source.apl", "start": "0xC000" }
        ],
        "execAddress": "0x0000", 
        "topOfStack": "0xBFFF"
    }
    ]
}