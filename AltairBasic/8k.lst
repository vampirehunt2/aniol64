04B5  02                	STAX	B
04B6  03                	INX	B
04B7  13                	INX	D
04B8  CD D704           	CALL	CMHLLTDE
04BB  D2 B404           	JNC	LINEDELL
04BE  C1                	POP	B
04BF                    LINEDELU:
