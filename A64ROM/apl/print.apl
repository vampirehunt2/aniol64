% PRINTSTR fname 13cmdline<-$80c0strobe<-$0080busy<-$0002paper<-$0004err<-$0008lptout<-$0079lptin<-$0078fname<-Tok(cmdline)IF !Exists(fname)  WriteS "DOS error"  STOPENDIFOpen(fname)WHILE !Eof()  ChkSt  FRead c  IF c=13: c<-10;  c<-c|strobe  Put lptout,c  c<-c&!strobe  Put lptOut,c  c<-c|strobe  Put lptOut,cLOOP    STOPPROC ChkStRETEND